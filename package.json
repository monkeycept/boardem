{
  "name": "skyloft",
  "private": true,
  "version": "1.0.0",
  "description": "Build your dream loft, blast your music, and visit other passengers' rooms while flying.",
  "type": "module",
  "homepage": "https://monkeycept.github.io/boardem/",
  "repository": {
    "type": "git",
    "url": "https://github.com/monkeycept/boardem.git"
  },
  "bugs": {
    "url": "https://github.com/monkeycept/boardem/issues"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:single": "tsc && vite build --mode single",
    "preview": "vite preview",
    "deploy": "npm run build && gh-pages -d dist",
    "lint": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "type-check": "tsc --noEmit",
    "icons": "python3 scripts/make_icons.py",
    "palette": "python3 scripts/make_palette.py"
  },
  "dependencies": {
    "ammojs-typed": "^1.1.0",
    "canvas-confetti": "^1.9.3",
    "firebase": "^10.14.1",
    "framer-motion": "^11.11.0",
    "html5-qrcode": "^2.3.8",
    "konva": "^9.3.16",
    "lucide-react": "^0.453.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.4.1",
    "react-konva": "^18.2.10",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.6.4",
    "@types/node": "^20.16.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "gh-pages": "^6.2.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-pwa": "^0.20.5",
    "vite-plugin-singlefile": "^2.0.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "pwa",
    "react",
    "vite",
    "firebase",
    "tailwind",
    "airplane",
    "loft",
    "real-time"
  ],
  "license": "MIT"
}
